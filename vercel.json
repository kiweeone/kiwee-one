      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/fintech",
      "destination": "/fintech/index.html"
    },
    {
      "source": "/creative",
      "destination": "/creative/index.html"
    },
    {
      "source": "/edtech",
      "destination": "/edtech/index.html"
    },
    {
      "source": "/democracy",
      "destination": "/democracy/index.html"
    },
    {
      "source": "/four-bulgarias",
      "destination": "/four-bulgarias/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
