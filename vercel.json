{
  "redirects": [
    {
      "source": "/dapper-butler",
      "destination": "https://dapperbutler.com/",
      "permanent": true
    },
    {
      "source": "/dapper-butler/",
      "destination": "https://dapperbutler.com/",
      "permanent": true
    },
    {
      "source": "/dapper-butler/:path*",
      "destination": "https://dapperbutler.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/fintech",
      "destination": "/fintech/index.html"
    },
    {
      "source": "/creative",
      "destination": "/creative/index.html"
    },
    {
      "source": "/edtech",
      "destination": "/edtech/index.html"
    },
    {
      "source": "/democracy",
      "destination": "/democracy/index.html"
    },
    {
      "source": "/four-bulgarias",
      "destination": "/four-bulgarias/index.html"
    },
    {
      "source": "/p/poligona-fxzd5g1iwikb",
      "destination": "/p/poligona-fxzd5g1iwikb/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
